---
import { useI18n, type Locale } from "@utils/i18n";
import { mainFooter } from "./footer";

const socialLinks = [
  { href: "https://feb.unej.ac.id", icon: "bi-globe", class: "facebook" },
  {
    href: "https://www.youtube.com/channel/UC2JKdusMUBCMj-XvTcZ_4NA",
    icon: "bi-youtube",
    class: "youtube",
  },
  {
    href: "https://www.facebook.com/FakultasEkonomidanBisnis",
    icon: "bi-facebook",
    class: "facebook",
  },
  {
    href: "https://www.instagram.com/febunej",
    icon: "bi-instagram",
    class: "instagram",
  },
  {
    href: "https://www.tiktok.com/@febunej",
    icon: "bi-tiktok",
    class: "tiktok",
  },
];

const t = useI18n(mainFooter, Astro.currentLocale as Locale);

const contacts = [
  { icon: "bi-geo-alt-fill", value: t("contact.address") },
  { icon: "bi-envelope-fill", value: "feb@unej.ac.id" },
  { icon: "bi-telephone-fill", value: "(0331) 337990" },
  { icon: "bi-whatsapp", value: "082337463327" },
];

const services = [
  { label: t("services.febLaporApp"), href: "https://lapor.feb.unej.ac.id" },
  {
    label: t("services.febCloudStorage"),
    href: "https://cloud.feb.unej.ac.id",
  },
  { label: t("services.lp2m"), href: "https://lp2m.unej.ac.id" },
  { label: t("services.lpmpp"), href: "https://lp3m.unej.ac.id" },
  { label: t("services.library"), href: "https://library.unej.ac.id" },
  { label: t("services.uptti"), href: "https://uptti.unej.ac.id/" },
];

const navigation = [
  { label: t("nav.home"), href: "/" },
  { label: t("nav.ppid"), href: "/ppid" },
  { label: t("nav.information"), href: "/info" },
  { label: t("nav.faq"), href: "/faq" },
  { label: t("nav.leadership"), href: "/leaders" },
  { label: t("nav.lectures"), href: "/lectures" },
];

const year = new Date().getFullYear();
---

<footer class="footer-main">
  <div class="footer-content">
    <div class="container">
      <div class="footer-grid d-flex flex-column flex-md-row gap-5">
        <!-- Brand -->
        <div class="footer-brand">
          <div class="brand-card">
            <div class="logo-wrapper">
              <img
                src="https://feb.unej.ac.id/assets/temabiru/img/logo.webp"
                alt="Logo FEB UNEJ"
                class="brand-logo"
              />
            </div>

            <a href="https://feb.unej.ac.id" class="brand-title">
              <h2>{t("card.faculty")}</h2>
              <h3>{t("card.university")}</h3>
            </a>

            <div class="brand-contact">
              <p><i class="bi bi-telephone-fill"></i>(0331) 337990</p>
              <p><i class="bi bi-whatsapp"></i>082337463327</p>
              <p><i class="bi bi-envelope-fill"></i>feb@unej.ac.id</p>
            </div>

            <div class="social-links">
              {
                socialLinks.map((item) => (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`social-btn ${item.class}`}
                  >
                    <i class={`bi ${item.icon}`} />
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 w-100">
          <!-- Contact -->
          <div
            class="footer-section d-flex flex-md-column row-cols-2 row-cols-md-1"
          >
            <div>
              <h4 class="section-title position-relative">
                <span>{t("card.contactTitle")}</span>
              </h4>
            </div>
            <div class="contact-list">
              {
                contacts.map((item) => (
                  <div class="contact-item">
                    <i class={`bi ${item.icon}`} />
                    <span>{item.value}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Services -->
          <div
            class="footer-section d-flex flex-md-column row-cols-2 row-cols-md-1"
          >
            <div>
              <h4 class="section-title position-relative">
                <span>{t("card.servicesTitle")}</span>
              </h4>
            </div>
            <nav class="footer-nav">
              {
                services.map((item) => (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="nav-link"
                  >
                    <i class="bi bi-arrow-right-circle-fill" />
                    <span>{item.label}</span>
                  </a>
                ))
              }
            </nav>
          </div>

          <!-- Navigation -->
          <div
            class="footer-section d-flex flex-md-column row-cols-2 row-cols-md-1"
          >
            <div>
              <h4 class="section-title position-relative">
                <span>{t("card.navigationTitle")}</span>
              </h4>
            </div>
            <nav class="footer-nav">
              {
                navigation.map((item) => (
                  <a href={item.href} class="nav-link">
                    <i class="bi bi-arrow-right-circle-fill" />
                    <span>{item.label}</span>
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-copyright">
    <div class="container">
      <p>
        &copy;{year}
        <a href="#">PPID FEB UNEJ</a>. {t("card.copyright")}
      </p>
    </div>
  </div>
</footer>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap");

  :root {
    --primary-color: #0066cc;
    --primary-dark: #004999;
    --secondary-color: #00d4ff;
    --accent-gold: #ffd700;
    --bg-dark: #0a1628;
    --bg-darker: #050b16;
    --text-light: #e8eef7;
    --text-muted: #8b9bb5;
    --border-color: rgba(255, 255, 255, 0.08);
  }

  .footer-main {
    background: #0a1628;
    background: linear-gradient(
      180deg,
      rgba(10, 22, 40, 1) 0%,
      rgba(5, 11, 22, 1) 100%
    );
    position: relative;
    overflow: hidden;
    margin-top: 5rem;
  }

  .footer-main::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--secondary-color) 50%,
      transparent 100%
    );
    opacity: 0.5;
  }

  .footer-content {
    padding: 5rem 0 3rem;
    position: relative;
  }

  .footer-grid {
    animation: fadeInUp 0.8s ease-out;
  }

  /* Brand Section */
  .footer-brand {
    animation: slideInLeft 0.6s ease-out;
  }

  .brand-card {
    background: linear-gradient(
      135deg,
      rgba(0, 102, 204, 0.15) 0%,
      rgba(0, 212, 255, 0.05) 100%
    );
    padding: 2.5rem;
    border-radius: 20px;
    border: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brand-card::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      rgba(0, 212, 255, 0.1) 0%,
      transparent 70%
    );
    animation: pulse 4s ease-in-out infinite;
  }

  .brand-card:hover {
    transform: translateY(-5px);
    border-color: var(--secondary-color);
    box-shadow: 0 20px 40px rgba(0, 212, 255, 0.2);
  }

  .logo-wrapper {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .brand-logo {
    width: 120px;
    height: 120px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 212, 255, 0.3));
    transition: transform 0.4s ease;
  }

  .brand-card:hover .brand-logo {
    transform: scale(1.05) rotate(2deg);
  }

  .brand-title {
    text-decoration: none;
    display: block;
    text-align: center;
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
  }

  .brand-title h2 {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-light);
    margin: 0 0 0.3rem 0;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .brand-title h3 {
    font-family: "DM Sans", sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--secondary-color);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .brand-title:hover h2 {
    color: var(--secondary-color);
  }

  .brand-contact {
    margin-bottom: 1.5rem;
  }

  .brand-contact p {
    font-family: "DM Sans", sans-serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .brand-contact i {
    color: var(--secondary-color);
    font-size: 1rem;
  }

  .btn-website {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.8rem;
    background: linear-gradient(
      135deg,
      var(--primary-color) 0%,
      var(--primary-dark) 100%
    );
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-family: "DM Sans", sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    border: 2px solid transparent;
  }

  .btn-website::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transition: left 0.5s ease;
  }

  .btn-website:hover::before {
    left: 100%;
  }

  .btn-website:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 102, 204, 0.4);
    border-color: var(--secondary-color);
  }

  .btn-website i {
    font-size: 1.1rem;
    transition: transform 0.3s ease;
  }

  .btn-website:hover i {
    transform: translateX(4px);
  }

  /* Footer Sections */
  .footer-section {
    animation: fadeInUp 0.8s ease-out;
  }

  .footer-section:nth-child(2) {
    animation-delay: 0.1s;
  }

  .footer-section:nth-child(3) {
    animation-delay: 0.2s;
  }

  .footer-section:nth-child(4) {
    animation-delay: 0.3s;
  }

  .section-title {
    font-family: "Playfair Display", serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-light);
    margin-bottom: 1.8rem;
    position: relative;
    display: inline-block;
  }

  .section-title span {
    position: relative;
    z-index: 1;
  }

  .section-title::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 50px;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--secondary-color) 0%,
      transparent 100%
    );
    border-radius: 2px;
  }

  /* Contact List */
  .contact-list {
    margin-bottom: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: all 0.3s ease;
    padding: 0.5rem 0;
  }

  .contact-item:hover {
    color: var(--text-light);
    transform: translateX(5px);
  }

  .contact-item i {
    color: var(--secondary-color);
    font-size: 1.1rem;
    margin-top: 2px;
    min-width: 20px;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .social-btn {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-light);
    font-size: 1.3rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .social-btn::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%);
    transition:
      width 0.4s ease,
      height 0.4s ease;
  }

  .social-btn:hover::before {
    width: 100%;
    height: 100%;
  }

  .social-btn:hover {
    transform: translateY(-5px) scale(1.05);
    border-color: currentColor;
    box-shadow: 0 8px 20px rgba(0, 212, 255, 0.3);
  }

  .social-btn.youtube:hover {
    color: #ff0000;
    box-shadow: 0 8px 20px rgba(255, 0, 0, 0.3);
  }

  .social-btn.facebook:hover {
    color: #1877f2;
    box-shadow: 0 8px 20px rgba(24, 119, 242, 0.3);
  }

  .social-btn.instagram:hover {
    color: #e4405f;
    box-shadow: 0 8px 20px rgba(228, 64, 95, 0.3);
  }

  .social-btn.tiktok:hover {
    color: #00f2ea;
    box-shadow: 0 8px 20px rgba(0, 242, 234, 0.3);
  }

  /* Navigation Links */
  .footer-nav {
    display: flex;
    flex-direction: column;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: "DM Sans", sans-serif;
    font-size: 0.95rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0.5rem 0;
    position: relative;
  }

  .nav-link i {
    color: var(--secondary-color);
    font-size: 1rem;
    transition: all 0.3s ease;
    opacity: 0.6;
  }

  .nav-link:hover {
    color: var(--text-light);
    transform: translateX(8px);
  }

  .nav-link:hover i {
    opacity: 1;
    transform: rotate(90deg);
  }

  /* Copyright Section */
  .footer-copyright {
    background: var(--bg-darker);
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
  }

  .copyright-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: "DM Sans", sans-serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-content a {
    color: var(--secondary-color);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
  }

  .copyright-content a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--secondary-color);
    transition: width 0.3s ease;
  }

  .copyright-content a:hover::after {
    width: 100%;
  }

  .copyright-content a:hover {
    color: var(--text-light);
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.6;
    }
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
  }

  @media (max-width: 768px) {
    .footer-content {
      padding: 3rem 0 2rem;
    }

    .brand-card {
      padding: 2rem;
    }

    .brand-title h2 {
      font-size: 1.4rem;
    }

    .brand-title h3 {
      font-size: 1rem;
    }

    .copyright-content {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .brand-logo {
      width: 100px;
      height: 100px;
    }

    .section-title {
      font-size: 1.2rem;
    }

    .btn-website {
      width: 100%;
      justify-content: center;
    }
  }
</style>
