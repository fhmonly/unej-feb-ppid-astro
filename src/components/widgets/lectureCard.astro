---
interface Props {
  image: string;
  name: string;
  department: string; // berisi HTML
}

const { image, name, department } = Astro.props as Props;
---

<div class="col text-center team-style-05 mb-3">
  <div
    class="position-relative mb-35px border-bottom border-color-transparent-dark-very-light last-paragraph-no-margin"
  >
    <img src={image} alt="" />

    <div
      class="w-100 h-100 d-flex flex-column justify-content-end align-items-center p-30px team-content bg-gradient-white-transparent"
    >
      <!-- social icon (opsional) -->
    </div>
  </div>

  <div class="text-dark-gray lh-22 fs-24 alt-font">
    {name}
  </div>

  <span set:html={department} />
</div>
