---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<section>
  <div class:list={["container", className]}>
    <div class="row">
      <div class="col-lg-6">
        <div class="position-sticky top-100px md-mb-30px">
          <span
            class="fs-60 md-fs-60 alt-font fw-600 ls-minus-3px md-ls-minus-2px"
          >
            {title}
          </span>
        </div>
      </div>

      <div class="col-xl-5 col-lg-6 offset-xl-1">
        <slot />
      </div>
    </div>
  </div>
</section>
