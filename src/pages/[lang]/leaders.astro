  },
  {
    image:
      "https://next-level-study.com/wp-content/uploads/2024/10/Prof._Stella_Christie_Wakil_Menteri_Pendidikan_Tinggi_Sains_dan_Teknologi_2024_cropped.jpg",
    name: "Prof. Dr. Novi Puspitasari, S.E., M.M",
    department: "Wakil Dekan I",
  },
  {
    image:
      "https://next-level-study.com/wp-content/uploads/2024/10/Prof._Stella_Christie_Wakil_Menteri_Pendidikan_Tinggi_Sains_dan_Teknologi_2024_cropped.jpg",
    name: "Dr. Nining Ika Wahyuni, S.E. M.Sc, Ak.",
    department: "Wakil Dekan II",
  },
  {
    image:
      "https://next-level-study.com/wp-content/uploads/2024/10/Prof._Stella_Christie_Wakil_Menteri_Pendidikan_Tinggi_Sains_dan_Teknologi_2024_cropped.jpg",
    name: "Dr. Teguh Hadi Priyono, S.E., M.Si.",
    department: "Wakil Dekan III",
  },
];

const stafItems = [
  {
    image:
      "https://next-level-study.com/wp-content/uploads/2024/10/Prof._Stella_Christie_Wakil_Menteri_Pendidikan_Tinggi_Sains_dan_Teknologi_2024_cropped.jpg",
    name: "Nurina Fitrianingtyas, SKM.",
    department: "Wakil Koordinator Keuangan dan Kepegawaian",
  },
  {
    image:
      "https://next-level-study.com/wp-content/uploads/2024/10/Prof._Stella_Christie_Wakil_Menteri_Pendidikan_Tinggi_Sains_dan_Teknologi_2024_cropped.jpg",
    name: "Sugianto, S.E., M.M.",
    department: "Wakil Koordinator Akademik, Kemahasiswaan dan Alumni",
