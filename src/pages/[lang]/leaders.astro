const leadershipJson = {
  en: {
    title: "Leadership",
  },
  id: {
    title: "Kepemimpinan",
  },
};
const t = useI18n(leadershipJson, Astro.currentLocale as any);
---

<Layout title={t("title")}>
  <WidgetsPageTitleTypografi
    image="https://i.pinimg.com/originals/e6/fc/70/e6fc7007970f0d1a190637bb630fc44e.jpg"
    title={t("title")}
  />
  <ModulesLeadershipList
    title="Pejabat Dekanat Fakultas Ekonomi dan Bisnis"
    suptitle="Dekanat"
    items={dekanatItems}
  />
  <ModulesLeadershipList
    title="Pejabat Tenaga Kependidikan Fakultas Ekonomi dan Bisnis"
    suptitle="Staf Tenaga Kependidikan"
