---
import CounterSection from "@/components/modules/home/counterSection.astro";
import {
  generateMultiLocaleStaticPaths,
  useI18n,
  type Locale,
} from "@/utils/i18n";
import ModulesHomePublicInformation from "@components/modules/home/publicInfo.astro";
import ModulesHomeReport from "@components/modules/home/report.astro";
import ModulesHomeSlider from "@components/modules/home/slider.astro";
import Layout from "@layouts/main.astro";

export async function getStaticPaths() {
  return generateMultiLocaleStaticPaths();
}
const pagesJson = {
  id: {
    title: "Beranda",
  },
  en: {
    title: "Home",
  },
};
const t = useI18n(pagesJson, Astro.currentLocale as Locale);
---

<Layout title={t("title")}>
  <ModulesHomeSlider />
  <CounterSection />
  <ModulesHomeReport />
  <ModulesHomePublicInformation />
</Layout>
